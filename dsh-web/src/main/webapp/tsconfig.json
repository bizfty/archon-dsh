{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/cosmokit": ["vendor/@deepseek-ai/cosmokit"],
      "@deepseek-ai/schemastery": ["vendor/@deepseek-ai/schemastery"],
      "@deepseek-ai/dsh-client-schema-form": ["vendor/@deepseek-ai/dsh-client-schema-form"],
      "@standard-schema/spec": ["vendor/@standard-schema/spec"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts", "vendor/**/*.d.ts"]
}
